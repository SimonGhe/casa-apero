# Phase 1 uses the official catalogue and browser-local cart storage only.
# Never put credentials in VITE_* values: they are public in the browser.

# Only publish an email after approval, especially if it belongs to a student.
# An unapproved address is excluded from the browser build.
# Restart Vite or rebuild after changing these values.
CASA_PUBLIC_CONTACT_EMAIL=
CASA_PUBLIC_CONTACT_EMAIL_APPROVED=false

{
  "name": "casa-apero",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "dev:admin": "vite --mode admin --host 127.0.0.1 --port 5180",
    "build:admin": "pnpm typecheck && vite build --mode admin",
    "build:admin-preview": "pnpm typecheck && vite build --mode admin-preview",
    "dev:admin-preview": "vite --mode admin-preview --host 127.0.0.1 --port 5185",
    "db:admin-preview:local": "node scripts/prepare-admin-preview-local.mjs",
    "verify:admin-preview:local": "node scripts/verify-admin-preview-local.mjs",
    "test:admin-preview": "playwright test --config playwright.admin-preview.config.ts",
    "test:admin": "playwright test --config playwright.admin.config.ts",
    "demo:admin": "node scripts/admin-demo.mjs",
    "build": "pnpm typecheck && vite build",
    "build:staging": "pnpm typecheck && vite build --mode staging",
    "deploy:staging": "node scripts/deploy-staging.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "typecheck": "tsc -b && tsc -p tsconfig.worker.json",
    "db:migrate": "wrangler d1 migrations apply DB --local --config wrangler.local.jsonc",
    "db:inspect": "wrangler d1 execute DB --local --config wrangler.local.jsonc --command \"SELECT reference, request_status, contract_status, subtotal_cents FROM orders ORDER BY created_at DESC LIMIT 10\"",
    "demo:order": "node scripts/local-demo.mjs",
    "demo:verify": "node scripts/local-demo.mjs verify",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:staging": "playwright test --config playwright.staging.config.ts"
  },
  "dependencies": {
    "jose": "^6.2.13",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.65.0",
    "@cloudflare/workers-types": "^5.20261023.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "miniflare": "^5.20261019.2-beta",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  }
}
